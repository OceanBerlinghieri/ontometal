@base <https://w3id.org/ontometal#> .

<https://w3id.org/ontometal#> rdf:type owl:Ontology ;
                               owl:versionIRI <https://w3id.org/ontometal#-2.0.0> ;
                               owl:imports <http://purl.org/ontology/mo/> ;
                               <http://purl.org/dc/elements/1.1/contributor> "Ocean Berlinghieri" ;
                               <http://purl.org/dc/elements/1.1/creator> "Ocean Berlinghieri" ;
                               <http://purl.org/dc/elements/1.1/date> "2026-04-19" ;
                               <http://purl.org/dc/elements/1.1/publisher> "Ocean Berlinghieri" ;
                               <http://purl.org/dc/elements/1.1/title> "OntoMetal: An Ontology for Metal Music" ;
                               <http://purl.org/dc/terms/license> "CC BY 4.0" ;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "om" ;
                               <http://purl.org/vocab/vann/preferredNamespaceUri> "https://w3id.org/ontometal" ;
                               rdfs:comment "This ontology is designed to represent the domain of metal music, including bands, albums, releases, and related concepts. It provides a structured framework for organizing and linking information about metal music entities." ;
                               owl:versionInfo "Version built from code" .

