###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/ontology/ao/genre
<http://purl.org/ontology/ao/genre> rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/based_near
<http://xmlns.com/foaf/0.1/based_near> rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/made
<http://xmlns.com/foaf/0.1/made> rdf:type owl:ObjectProperty .


###  http://xmlns.com/foaf/0.1/maker
<http://xmlns.com/foaf/0.1/maker> rdf:type owl:ObjectProperty .


###  https://w3id.org/ontometal#hasCountry
:hasCountry rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/based_near> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :Band ,
                        :Label ;
            rdfs:range :Country ;
            rdfs:comment "Indicates the country associated with an entity"@en ;
            rdfs:label "Has Country"@en .


###  https://w3id.org/ontometal#hasGenre
:hasGenre rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://purl.org/ontology/ao/genre> ;
          rdf:type owl:TransitiveProperty ;
          rdfs:domain :Band ;
          rdfs:range :Genre ;
          rdfs:comment "Indicates the genre associated with an entity"@en ;
          rdfs:label "Has Genre"@en .


###  https://w3id.org/ontometal#hasSpecialization
:hasSpecialization rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://purl.org/ontology/ao/genre> ;
                   rdf:type owl:TransitiveProperty ;
                   rdfs:domain :Label ;
                   rdfs:range :Genre ;
                   rdfs:comment "Indicates the specialization associated with an entity"@en ;
                   rdfs:label "Has Specialization"@en .


###  https://w3id.org/ontometal#producedBy
:producedBy rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain :Band ;
            rdfs:range :Label ;
            rdfs:comment "Indicates an entity produced by another entity"@en ;
            rdfs:label "Produced By"@en .


###  https://w3id.org/ontometal#producer
:producer rdf:type owl:ObjectProperty ;
          rdfs:domain :Label ;
          rdfs:range :Band ;
          rdfs:comment "Indicates the producer of an entity"@en ;
          rdfs:label "Producer"@en .


###  https://w3id.org/ontometal#releasedBy
:releasedBy rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/made> ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain :Release ;
            rdfs:range :Band ;
            rdfs:comment "Indicates the entity that released another entity"@en ;
            rdfs:label "Released By"@en .


###  https://w3id.org/ontometal#releases
:releases rdf:type owl:ObjectProperty ;
          rdfs:subPropertyOf <http://xmlns.com/foaf/0.1/maker> ;
          rdfs:domain :Band ;
          rdfs:range :Release ;
          rdfs:comment "Indicates the entity that is released by another entity"@en ;
          rdfs:label "Releases"@en .


